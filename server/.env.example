# ==============================================================
# SEORA E-Commerce - Backend API Environment Configuration
# ==============================================================
# Copy this file to '.env' in this directory and update with your real values.
# NEVER commit the actual '.env' file containing real secrets to version control.

# --------------------------------------------------------------
# 1. Server Configuration
# --------------------------------------------------------------
# Port the Express server will listen on (Default: 5000)
PORT=5000

# Node runtime environment ('development' | 'production' | 'test')
# In 'production', cookies require HTTPS and stack traces are suppressed.
NODE_ENV=development

# --------------------------------------------------------------
# 2. Database Configuration (MongoDB)
# --------------------------------------------------------------
# MongoDB Connection String:
# - For local development: mongodb://127.0.0.1:27017/koreanweb
# - For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@<cluster-domain>/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecom?retryWrites=true&w=majority

# --------------------------------------------------------------
# 3. JWT Authentication Security
# --------------------------------------------------------------
# Cryptographically secure secret keys for signing JWT tokens.
# Tip: Generate in terminal with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=your_long_cryptographically_secure_access_secret_key_here
ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_SECRET=your_long_cryptographically_secure_refresh_secret_key_here
REFRESH_TOKEN_EXPIRY=10d

# --------------------------------------------------------------
# 4. CORS & Allowed Frontend Client Origins
# --------------------------------------------------------------
# Allowed origins for Cross-Origin Resource Sharing (CORS).
# In local development, localhost, 127.0.0.1, and private LAN IPs (192.168.x.x, 10.x.x.x) are automatically allowed.
# For production, set these to your live deployed domain URLs (e.g., https://yourdomain.com).
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
FRONTEND_URL=http://localhost:5173
