# ==============================================================
# SEORA Admin Control Center & Full-Stack Backend API
# Deployment Environment Configuration Template
# ==============================================================

# Node runtime environment (development | production)
NODE_ENV=production
PORT=5000

# Live MongoDB Atlas Database Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecom?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random 64+ character strings)
ACCESS_TOKEN_SECRET=your_long_cryptographically_secure_access_secret_key_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_long_cryptographically_secure_refresh_secret_key_here
REFRESH_TOKEN_EXPIRY=10d

# Allowed Origins for CORS (Customer storefront and Admin URLs)
CLIENT_URL=https://www.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# Frontend Configuration:
# API Base URL (leave as /api for same-domain serverless deployment on Vercel)
VITE_API_BASE_URL=/api

# Customer Storefront URL (used for "Visit Storefront" links in Admin sidebar)
VITE_CLIENT_URL=https://www.yourdomain.com
